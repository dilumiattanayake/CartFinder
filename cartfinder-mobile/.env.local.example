# CartFinder Mobile App - Environment Configuration
# Copy as .env.local for local overrides (optional)

# API Configuration
# For Android Emulator: http://10.0.2.2:5001/api/v1 (default)
# For iOS Simulator: http://localhost:5001/api/v1
# For Physical Device: http://192.168.1.X:5001/api/v1 (replace X with your machine's LAN IP)

EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5001/api/v1

# Firebase Configuration (if needed to override)
# EXPO_PUBLIC_FIREBASE_API_KEY=...
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=...
# etc.
